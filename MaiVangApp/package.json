  "scripts": {
    "start": "expo start",
    "start:mobile": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-deployed-web.ps1",
    "web:expo": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-web.ps1",
    "check": "tsc --noEmit",
    "test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tests.ps1",
    "doctor": "npx expo-doctor",
    "export:web": "expo export --platform web",
    "test:e2e": "playwright test",
    "test:contract": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/verify-backend-contract.ps1",
    "test:deploy": "node tools/deploy-acceptance.mjs",
    "local:start": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/local-stack.ps1",
    "local:check": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/check-local-stack.ps1",
    "local:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/stop-local-stack.ps1"
  },
  "private": true,
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.3.0",
