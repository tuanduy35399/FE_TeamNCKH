{
  "expo": {
    "name": "MaiCare",
    "slug": "maicare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Cho phép MaiCare sử dụng camera để chụp ảnh lá mai.",
        "NSPhotoLibraryUsageDescription": "Cho phép MaiCare truy cập thư viện để chọn ảnh lá mai."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.fe_team_nckh.app",
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép MaiCare truy cập thư viện để chọn ảnh lá mai.",
          "cameraPermission": "Cho phép MaiCare sử dụng camera để chụp ảnh lá mai.",
          "microphonePermission": false
        }
      ],
      "expo-secure-store",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "bc2d3ca6-2440-4866-95f6-1ab3f2cf9137"
      }
    },
    "owner": "duyduyctu"
  }
}
